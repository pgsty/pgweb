[Unit]
Description=PostgreSQL Chinese Community Website (pgsql.cc)
After=network.target postgres.service
Wants=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/data/app/pgsql.cc
Environment=DJANGO_SETTINGS_MODULE=pgweb.settings
ExecStart=/data/app/pgsql.cc/.venv/bin/gunicorn pgweb.wsgi:application --bind 127.0.0.1:8001 --workers 4 --timeout 120
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5
KillMode=mixed
UMask=0027

[Install]
WantedBy=multi-user.target
